# Copy to docker-compose.web.yml, create .env using .env.sample, and set TOKEN,
# MANAGER and WEB_ADMIN_TOKEN. Build THIS fork instead of using the upstream image.
services:
  main:
    build: .
    restart: unless-stopped
    env_file: .env
    environment:
      WEB_ADMIN_HOST: 0.0.0.0
      WEB_ADMIN_PORT: 8080
    ports:
      - "127.0.0.1:8080:8080"
    volumes:
      - ./config:/app/config
